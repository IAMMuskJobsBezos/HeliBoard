<?xml version="1.0" encoding="utf-8"?>
<!-- Elderly-phone shipped default: bold outline shift arrow (house/arrow pictogram), matching the
     reference screenshot model instead of the thin chevron this used to be. Unshifted = outline
     only (stroke, transparent fill) so the key's lavender fill shows through the middle; the
     shifted state (sym_keyboard_shift_shifted_rounded) reuses this exact path but solid-filled,
     so activating shift is visually obvious. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFF"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:strokeLineCap="round"
        android:pathData="M12,3 L21,12 L16,12 L16,19 L8,19 L8,12 L3,12 Z"/>
</vector>
