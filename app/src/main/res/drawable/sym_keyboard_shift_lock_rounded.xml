        android:fillColor="#FFF"
        android:pathData="M12,3 L21,12 L16,12 L16,19 L8,19 L8,12 L3,12 Z"/>
    <path
        android:fillColor="#FFF"
        android:pathData="M6,21 L18,21 L18,23 L6,23 Z"/>
</vector>
