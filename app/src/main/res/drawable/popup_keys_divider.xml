<?xml version="1.0" encoding="utf-8"?>
<!-- Elderly-phone shipped default: transparent, not a visible line - a divider between options
     reads as "separate cells" rather than one continuous popup pill. Kept as a real (if invisible)
     divider rather than removed outright so the row's per-key spacing is unaffected. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp" android:insetBottom="3dp"
    android:shape="rectangle">
    <solid android:color="#00FFFFFF"/>
    <size android:width="1dp" android:height="30dp"/>
</shape>